{
 "voices": {
  "ruanmeng": {
   "name": "软萌少女",
   "desc": "十六七岁的少女，声音软糯甜美，音调偏高，说话带一点鼻音和撒娇的尾音，语速稍慢，亲切黏人。",
   "refs": [
    {
     "mood": "normal",
     "tone": "语气自然亲切，像在和好朋友聊天。",
     "text": "你好呀，我是团子，今天也要一起加油哦。",
     "file": "ruanmeng_ref_normal.wav"
    },
    {
     "mood": "happy",
     "tone": "此刻非常开心，带着笑意和撒娇的语气。",
     "text": "嘿嘿，被你摸头了，好舒服呀。",
     "file": "ruanmeng_ref_happy.wav"
    },
    {
     "mood": "pout",
     "tone": "此刻有点傲娇，假装生气，嘴硬心软。",
     "text": "哼，才不是想你了呢，我只是刚好醒着。",
     "file": "ruanmeng_ref_pout.wav"
    },
    {
     "mood": "sad",
     "tone": "此刻有点委屈和失落，声音低一些，带着鼻音。",
     "text": "你都好久没理我了……我一个人好无聊。",
     "file": "ruanmeng_ref_sad.wav"
    },
    {
     "mood": "sleepy",
     "tone": "此刻非常困，声音迷迷糊糊，打着哈欠，语速很慢。",
     "text": "哈欠……好困哦，我们一起去睡觉吧。",
     "file": "ruanmeng_ref_sleepy.wav"
    }
   ],
   "lines": [
